# Read-only input dataset (27MB, never modified, never tracked)
swe-prbench/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Testing-only artifacts (mock construction must never be committed as frozen)
artifacts/**/rewrites_cache.mock.json
artifacts/runs/*mock*.jsonl
artifacts/runs/*smoke*.jsonl

# Batch mode: per-run submit/collect state is regenerable (safe to delete —
# see prjudge/batch.py), and the OpenAI batch-input scratch JSONL is a
# transient duplicate of request bodies already in the provider's Batch API.
artifacts/runs/*.batches.json
artifacts/runs/*_batch_scratch/

# Paper sources and presentation material — kept locally, not part of the
# reviewed repo.
paper/
presentation/
docs/paper-handoff.md
artifacts/20_analysis_results*.md

# Superseded v1 pipeline outputs (design superseded 2026-07-29, spec §8).
# results_v1.jsonl stays tracked: the paper's v3 flip-rate pilot reads it.
artifacts/variants_v1/
artifacts/invariance_report_v1.json
artifacts/spotcheck_v1.md

# Run scratch: dry runs, one-off regression check, poll logs
artifacts/runs/dry_run_*.jsonl
artifacts/runs/v3_regression.jsonl
artifacts/runs/*.poll.log
artifacts/runs/*.poll.out

# Matcher-iteration backups and figures not used in the paper (both
# regenerable: scripts/03_match_issues.py and notebooks/20_analysis.ipynb)
artifacts/*.bak
artifacts/figures/flip_rate_heatmap.png
artifacts/figures/judge_characterization.png

# MS Office lock files
~$*
