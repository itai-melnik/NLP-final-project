# Copy to .env and fill in. .env is gitignored and never committed.
# Only needed for real Stage-2 judge runs (not for mock mode or Stages 0/1/3).

# Claude-family judge + construction model (Anthropic).
ANTHROPIC_API_KEY=

# GPT-family judge (OpenAI).
OPENAI_API_KEY=

# Open-source judge via a hosted OpenAI-compatible endpoint
# (e.g. Together / Fireworks / Groq). Base URL is set in config/experiment.yaml.
OPEN_JUDGE_API_KEY=
